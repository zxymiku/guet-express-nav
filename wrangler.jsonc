{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guet-express-nav",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "map.zxymiku.top",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
